<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TotalUpdater</AssemblyName>
    <RootNamespace>TotalUpdater.Next</RootNamespace>
    <Version>0.12.0</Version>
    <AssemblyVersion>0.12.0.0</AssemblyVersion>
    <FileVersion>0.12.0.0</FileVersion>
    <ApplicationIcon>Assets\TotalUpdater.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WcxProbe.x86\WcxProbe.x86.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WcxProbe.x64\WcxProbe.x64.csproj" ReferenceOutputAssembly="false" />
    <EmbeddedResource Include="Catalog\plugin-catalog.json" />
    <EmbeddedResource Include="..\WcxProbe.x86\bin\$(Configuration)\net48\WcxProbe.x86.exe" LogicalName="TotalUpdater.Next.WcxProbe.x86.exe" />
    <EmbeddedResource Include="..\WcxProbe.x64\bin\$(Configuration)\net48\WcxProbe.x64.exe" LogicalName="TotalUpdater.Next.WcxProbe.x64.exe" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
