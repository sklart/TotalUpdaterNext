<Window x:Class="TotalUpdater.Next.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Total Updater Next" Height="700" Width="1080" MinHeight="520" MinWidth="820">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock FontSize="30" FontWeight="Bold">TOTAL <Run Foreground="#16802B">Updater</Run> <Run Foreground="#777" FontSize="18">Next</Run></TextBlock>
      <TextBlock Margin="1,0,0,14" FontSize="15">Проверка обновлений Total Commander и его плагинов</TextBlock>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">wincmd.ini:</TextBlock>
        <TextBox x:Name="IniPathBox" Grid.Column="1" VerticalContentAlignment="Center" IsReadOnly="True"/>
        <Button Grid.Column="2" Content="Выбрать…" Click="BrowseIni_Click" Margin="8,0,0,0"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Button Content="Найти плагины" Background="{StaticResource AccentBrush}" Foreground="White" Click="FindPlugins_Click"/>
        <Button Content="Проверить источники" Click="CheckSources_Click"/>
        <Button Content="Скачать выделенные" Click="DownloadSelected_Click"/>
        <Button Content="Пользовательские правила" Click="OpenRules_Click"/>
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#555" />
      </StackPanel>
    </StackPanel>
    <DataGrid x:Name="PluginGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" GridLinesVisibility="Horizontal" Margin="0,4,0,10" MouseDoubleClick="PluginGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="✓" Width="35" IsReadOnly="False" />
        <DataGridTextColumn Binding="{Binding Category}" Header="Тип" Width="190" />
        <DataGridTextColumn Binding="{Binding Name}" Header="Имя" Width="150" />
        <DataGridTextColumn Binding="{Binding LocalVersion}" Header="Установлена" Width="110" />
        <DataGridTextColumn Binding="{Binding LatestVersion}" Header="Новейшая" Width="110" />
        <DataGridTextColumn Binding="{Binding Status}" Header="Статус" Width="150" />
        <DataGridTextColumn Binding="{Binding FilePath}" Header="Файл (двойной щелчок — открыть источник)" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
    <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="10">
      <TextBlock TextWrapping="Wrap">Скачивание сохраняет архивы в папку «Загрузки\TotalUpdaterNext» и не распаковывает/не заменяет плагины. Для неизвестных плагинов добавьте правило.</TextBlock>
    </Border>
  </DockPanel>
</Window>
