<Window x:Class="TotalUpdater.Next.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TotalUpdater.Next.UI"
        Title="Total Updater Next" Width="980" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ui:FilterConverter x:Key="FilterConverter" />
    <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Padding="0,0,0,10"><StackPanel><TextBlock FontSize="28" FontWeight="Bold">TOTAL <Run Foreground="#16802B">Updater</Run> <Run FontSize="16" Foreground="#777">Next</Run></TextBlock><TextBlock FontSize="14">Обновление Total Commander и его плагинов</TextBlock></StackPanel></Border>
    <Border DockPanel.Dock="Bottom" Background="#F2F2F2" Padding="9"><TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/></Border>
    <TabControl>
      <TabItem Header="Обновления">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal"><Button Content="Найти плагины" Command="{Binding DiscoverCommand}"/><Button Content="Проверить обновления" Command="{Binding CheckCommand}"/><Button Content="Проверить доступность источников" Command="{Binding CheckSourceAvailabilityCommand}"/><Button Content="Скачать отмеченные" Command="{Binding DownloadCommand}"/><Button Content="Установить отмеченный" Command="{Binding InstallCommand}"/><Button Content="Откатить выбранный плагин" Command="{Binding RollbackCommand}"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><RadioButton Content="Все" IsChecked="{Binding FilterName, Converter={StaticResource FilterConverter}, ConverterParameter=All}"/><RadioButton Content="Обновления" Margin="18,0,0,0" IsChecked="{Binding FilterName, Converter={StaticResource FilterConverter}, ConverterParameter=Updates}"/><RadioButton Content="Неизвестные" Margin="18,0,0,0" IsChecked="{Binding FilterName, Converter={StaticResource FilterConverter}, ConverterParameter=Unknown}"/><RadioButton Content="Ошибки" Margin="18,0,0,0" IsChecked="{Binding FilterName, Converter={StaticResource FilterConverter}, ConverterParameter=Errors}"/></StackPanel>
          </StackPanel>
          <DataGrid ItemsSource="{Binding ItemsView}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" MinColumnWidth="70">
            <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#38659A" Margin="3,8,0,3"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
            <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Исключить из проверки" Command="{Binding ExcludeCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Вернуть в проверку" Command="{Binding RestoreExcludedCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Считать установленную версию актуальной" Command="{Binding AcceptVersionCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><Separator/><MenuItem Header="Информация" Command="{Binding InfoCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Открыть сайт" Command="{Binding OpenSiteCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Открыть расположение файла" Command="{Binding OpenPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Копировать путь" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
            <DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35"/><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="185" IsReadOnly="True"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="Установлена" Binding="{Binding InstalledVersion}" Width="125" IsReadOnly="True"/><DataGridTextColumn Header="Новейшая" Binding="{Binding AvailableVersion}" Width="125" IsReadOnly="True"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="230" IsReadOnly="True"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Источники">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Проверить доступность источников" Command="{Binding CheckSourceAvailabilityCommand}"/></StackPanel>
          <DataGrid ItemsSource="{Binding SourceDiagnostics}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns><DataGridTextColumn Header="Источник" Binding="{Binding Name}" Width="190" IsReadOnly="True"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="Время" Binding="{Binding ResponseTime}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*" IsReadOnly="True"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Каталог">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Проверить выбранный" Command="{Binding CheckCatalogCommand}"/><Button Content="Установить новый плагин" Command="{Binding InstallNewCommand}"/></StackPanel>
          <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap">Выберите один отсутствующий WFX, WLX или WDX. Сначала проверьте источник, затем подтвердите ZIP, файлы и регистрацию в INI. WCX остаётся только для обновления.</TextBlock>
          <DataGrid ItemsSource="{Binding CatalogItems}" AutoGenerateColumns="False" CanUserAddRows="False" MinColumnWidth="70" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns><DataGridCheckBoxColumn Header="✓" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="35"/><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="220" IsReadOnly="True"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="Установка" Binding="{Binding InstallStatus}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Доступная версия" Binding="{Binding AvailableVersion}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*" IsReadOnly="True"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Настройки"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Применить" Command="{Binding ApplySettingsCommand}"/><Button Content="По умолчанию" Command="{Binding DefaultSettingsCommand}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold">Обновления</TextBlock><CheckBox Content="Проверять Total Commander" IsChecked="{Binding Settings.CheckTotalCommander}"/><CheckBox Content="Проверять плагины" IsChecked="{Binding Settings.CheckPlugins}"/><CheckBox Content="Стабильные + prerelease" IsChecked="{Binding Settings.IncludePrerelease}"/><CheckBox Content="Использовать расширенное определение версии" IsChecked="{Binding Settings.UseExtendedVersionDetection}"/><CheckBox Content="Скрывать плагины с неопределённой версией" IsChecked="{Binding Settings.HideUnknownVersion}"/><TextBlock Margin="0,14,0,3" FontSize="18" FontWeight="SemiBold">Обнаружение плагинов</TextBlock><CheckBox Content="Искать также в plugin directories" IsChecked="{Binding ScanUnregisteredDirectories}"/><CheckBox Content="Показывать незарегистрированные плагины" IsChecked="{Binding Settings.ShowUnregisteredPlugins}"/><TextBlock Margin="0,14,0,3" FontSize="18" FontWeight="SemiBold">Загрузки</TextBlock><TextBlock>Каталог загрузок (%USERPROFILE%, %TEMP%, %COMMANDER_PATH%)</TextBlock><TextBox Text="{Binding Settings.DownloadDirectory, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Удалять ZIP после успешной установки" IsChecked="{Binding Settings.DeleteZipAfterInstall}"/><TextBlock Margin="0,14,0,3" FontSize="18" FontWeight="SemiBold">Сеть и кэш</TextBlock><StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center">Первый запрос, сек:</TextBlock><TextBox Width="55" Margin="8,0" Text="{Binding Settings.FirstRequestTimeoutSeconds}"/><TextBlock VerticalAlignment="Center">Retry, сек:</TextBlock><TextBox Width="55" Margin="8,0" Text="{Binding Settings.RetryTimeoutSeconds}"/><Button Content="Проверить соединение" Command="{Binding CheckSourceAvailabilityCommand}"/></StackPanel><CheckBox Content="Использовать сохранённые metadata при недоступности сети" IsChecked="{Binding Settings.UsePersistentMetadataCache}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Кэш: " VerticalAlignment="Center"/><TextBlock Text="{Binding CacheSize}" VerticalAlignment="Center"/><Button Content="Очистить кэш" Command="{Binding ClearCacheCommand}"/></StackPanel><TextBlock Margin="0,14,0,3" FontSize="18" FontWeight="SemiBold">Исключения</TextBlock><TextBlock Text="{Binding ExclusionCount, StringFormat=Исключений: {0}}"/><TextBlock>Используйте контекстное меню строки для управления исключениями.</TextBlock><TextBlock Margin="0,14,0,3" FontSize="18" FontWeight="SemiBold">Расположение</TextBlock><StackPanel Orientation="Horizontal"><TextBlock Width="190">wincmd.ini:</TextBlock><TextBox Width="400" Text="{Binding IniPath}" IsReadOnly="True"/><Button Content="Выбрать…" Command="{Binding BrowseIniCommand}"/></StackPanel><TextBlock Text="{Binding StorageMode}"/></StackPanel></ScrollViewer></DockPanel></TabItem>
      <TabItem Header="Локальная БД"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Пользовательская база имеет приоритет над встроенным каталогом."/><TextBlock Margin="0,10,0,10" Text="{Binding UserCatalogPath}" TextWrapping="Wrap"/><Button Content="Открыть / создать пользовательскую БД" Command="{Binding OpenUserCatalogCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/></StackPanel><DataGrid ItemsSource="{Binding UserCatalogEntries}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="180"/><DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
      <TabItem Header="О программе"><StackPanel Margin="18"><TextBlock FontSize="22" FontWeight="Bold">Total Updater Next</TextBlock><TextBlock Margin="0,12,0,0">Версия <Run Text="{Binding ApplicationVersion, Mode=OneWay}"/></TextBlock><TextBlock Margin="0,4,0,0">Windows 7 SP1+ · .NET Framework 4.8 · WPF</TextBlock><TextBlock Margin="0,12,0,0">GitHub: https://github.com/sklart/TotalUpdaterNext</TextBlock><TextBlock Margin="0,20,0,0" TextWrapping="Wrap">ZIP-обновления доступны для установленных WCX/WLX/WFX/WDX. Новые WFX/WLX/WDX можно установить из вкладки «Каталог» после явного подтверждения.</TextBlock></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
